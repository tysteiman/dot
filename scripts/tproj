#!/bin/bash

# Project picker: find git repos under ~/proj, fzf-select one, and jump to its
# tmux session (creating it with the files/servers/git/agent layout if needed).
# Works both inside tmux (switch-client) and outside (attach).
# Sessions with Claude needing you come first (state icon), then other running
# sessions (●), then everything else.
#
# Bound in ~/.tmux.conf (prefix+f / Alt-o) via display-popup; also used by `proj`.

export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

list() {
  export SESSIONS CLAUDE
  SESSIONS="$(tmux list-sessions -F '#S' 2>/dev/null)"
  CLAUDE="$("$(dirname "$0")/tclaude" sessions)"   # session<TAB>rank<TAB>icon
  find "$HOME/proj" -maxdepth 4 -name '.git' -prune 2>/dev/null \
    | sed 's|/\.git$||' \
    | awk '
        BEGIN {
          n = split(ENVIRON["SESSIONS"], a, "\n"); for (i = 1; i <= n; i++) act[a[i]] = 1
          # picker order by rank: waiting, error, done, working, idle
          m[5] = 0; m[4] = 1; m[2] = 2; m[3] = 3; m[1] = 4
          n = split(ENVIRON["CLAUDE"], c, "\n")
          for (i = 1; i <= n; i++) { split(c[i], f, "\t"); rk[f[1]] = f[2]; ic[f[1]] = f[3] }
        }
        {
          b = $0; sub(".*/", "", b); gsub(/[.:]/, "_", b)   # tmux session-name rules
          # sort key: Claude waiting first ... then other running sessions, then the rest
          key = (b in ic) ? m[rk[b]] : ((b in act) ? 5 : 9)
          mark = (b in ic) ? ic[b] : ((b in act) ? "●" : " ")
          printf "%d\t%s\t%s %s\t%s\n", key, b, mark, b, $0
        }' \
    | sort -t$'\t' -s -k1,1n -k2,2 \
    | cut -f3-
}

[ "$1" = "--list" ] && { list; exit 0; }

# Create a session with our standard windows (detached).
setup() {
  local dir="$1" name="$2"
  tmux new-session -d -c "$dir" -s "$name" -n files
  tmux new-window -d -t "=$name:" -n servers -c "$dir"
  tmux new-window -d -t "=$name:" -n git -c "$dir"
  tmux new-window -d -t "=$name:" -n agent -c "$dir"
  tmux select-window -t "=$name:files"
}

SELECTED="$(list | fzf --border=rounded --reverse --delimiter=$'\t' --with-nth=1 \
  --ansi --prompt='project> ' --header='● running · ✻ Claude working · bell waiting · check done' \
  --preview='ls -1A {2}' --preview-window=right:40%:border-left)"

[ -z "$SELECTED" ] && exit 1

DIR="$(cut -f2 <<<"$SELECTED")"
NAME="$(basename "$DIR")"; NAME="${NAME//[.:]/_}"

tmux has-session -t "=$NAME" 2>/dev/null || setup "$DIR" "$NAME"

if [ -n "$TMUX" ]; then
  tmux switch-client -t "=$NAME"
else
  tmux attach -t "=$NAME"
fi
