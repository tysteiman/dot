#!/bin/bash

# Window switcher: fzf over every window in every session, with a preview of
# the pane. Windows where Claude needs you sort first (bell/warn/check icon).
#
# Bound in ~/.tmux.conf (prefix+w / Alt-w) via display-popup.

export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

SEL="$("$(dirname "$0")/tclaude" windows \
  | awk -F'\t' 'BEGIN { m[5] = 0; m[4] = 1; m[2] = 2; m[3] = 3; m[1] = 4 }   # waiting, error, done, working, idle
      { printf "%d\t%s\t%s %s / %s\t%s\n", ($2 in m) ? m[$2] : 5, $1, $3, $4, $5, $6 }' \
  | sort -t$'\t' -s -k1,1n -k2,2 | cut -f2- \
  | fzf --ansi --border=rounded --reverse --delimiter=$'\t' --with-nth=2,3 \
      --prompt='window> ' \
      --preview='tmux capture-pane -ep -t {1}' --preview-window=right:55%:border-left)"

[ -z "$SEL" ] && exit 1

TARGET="$(cut -f1 <<<"$SEL")"
if [ -n "$TMUX" ]; then
  tmux switch-client -t "$TARGET"
else
  tmux attach -t "$TARGET"
fi
